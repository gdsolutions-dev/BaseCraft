{
  "name": "basecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop database application in the spirit of Microsoft Access",
  "author": "GD Solutions",
  "main": "out/main/index.js",
  "build": {
    "appId": "dev.gdsolutions.basecraft",
    "productName": "BaseCraft",
    "files": ["out/**/*", "!**/node_modules/**"],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "tar.gz"], "category": "Office" }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --configLoader runner",
    "e2e": "electron-vite build && playwright test",
    "bench": "vitest bench --run --configLoader runner --reporter=verbose"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@glideapps/glide-data-grid": "6.0.3",
    "i18next": "26.5.4",
    "lodash": "4.18.1",
    "lucide-react": "1.61.0",
    "marked": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.0",
    "react-responsive-carousel": "3.2.23"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
